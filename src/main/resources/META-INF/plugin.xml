<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <resource-bundle>messages.QilletniBundle</resource-bundle>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>dev.qilletni.intellij.QilletniPlugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Qilletni Language Support</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://qilletni.dev/">Adam Yarris</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <p>Support for <a href="https://qilletni.dev/">Qilletni</a>, a language for working with music streaming services.</p>
        <ul>
            <li>Highlighting, completion, navigation, Find Usages, Rename, structure view, folding and documentation</li>
            <li>Run scripts and build packages with the Qilletni toolchain, with logs in the Run and Build tool windows</li>
            <li>Dependencies from <code>qilletni_info.yml</code> and <code>qilletni.lock</code>, with one-click <code>qpm install</code>, publishing and registry completion</li>
            <li>Spotify-assisted music: pick songs, albums and playlists from Spotify while you type</li>
            <li>Navigation between <code>native fun</code> declarations and their Java implementations</li>
        </ul>
        <p>Start with File | New | Project | Qilletni, or open a project containing <code>qilletni-src/qilletni_info.yml</code>.</p>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Qilletni" language="Qilletni" extensions="ql" implementationClass="dev.qilletni.intellij.QilletniFileType"/>

        <lang.parserDefinition language="Qilletni" implementationClass="dev.qilletni.intellij.QilletniParserDefinition"/>

        <lang.ast.factory language="Qilletni" implementationClass="dev.qilletni.intellij.QilletniASTFactory"/>

        <lang.syntaxHighlighterFactory language="Qilletni" implementationClass="dev.qilletni.intellij.QilletniSyntaxHighlighterFactory"/>

        <colorSettingsPage implementation="dev.qilletni.intellij.QilletniColorSettingsPage"/>

        <lang.documentationProvider language="Qilletni" implementationClass="dev.qilletni.intellij.QilletniDocumentationProvider"/>

        <psi.referenceContributor language="yaml" implementation="dev.qilletni.intellij.yaml.QilletniYamlReferenceContributor"/>
        <completion.contributor language="yaml" implementationClass="dev.qilletni.intellij.yaml.QilletniYamlNativeClassCompletionContributor"/>
        <completion.contributor language="yaml" implementationClass="dev.qilletni.intellij.packages.QilletniManifestCompletionContributor"/>
        <localInspection language="yaml"
                         groupPath="Qilletni"
                         shortName="QilletniDependencyNotInstalled"
                         bundle="messages.QilletniBundle"
                         key="inspection.dependency.displayName"
                         groupName="Qilletni"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="dev.qilletni.intellij.packages.QilletniDependencyInspection"/>
        <localInspection language="yaml"
                          groupPath="Qilletni"
                          shortName="QilletniYamlNativeClassResolve"
                          displayName="Unresolved native class"
                          enabledByDefault="true"
                          implementationClass="dev.qilletni.intellij.yaml.QilletniYamlNativeClassResolveInspection"/>

        <psi.referenceContributor language="Qilletni" implementation="dev.qilletni.intellij.references.QilletniReferenceContributor"/>
        <completion.contributor language="Qilletni" implementationClass="dev.qilletni.intellij.completion.QilletniCompletionContributor"/>
        <lang.findUsagesProvider language="Qilletni" implementationClass="dev.qilletni.intellij.findusages.QilletniFindUsagesProvider"/>
        <renamePsiElementProcessor implementation="dev.qilletni.intellij.refactoring.QilletniRenameEntityAndConstructorProcessor"/>

        <lang.braceMatcher language="Qilletni" implementationClass="dev.qilletni.intellij.QilletniBraceMatcher"/>
        <lang.commenter language="Qilletni" implementationClass="dev.qilletni.intellij.editor.QilletniCommenter"/>
        <lang.foldingBuilder language="Qilletni" implementationClass="dev.qilletni.intellij.editor.QilletniFoldingBuilder"/>
        <lang.psiStructureViewFactory language="Qilletni" implementationClass="dev.qilletni.intellij.editor.QilletniStructureViewFactory"/>
        <lang.namesValidator language="Qilletni" implementationClass="dev.qilletni.intellij.editor.QilletniNamesValidator"/>
        <breadcrumbsInfoProvider implementation="dev.qilletni.intellij.editor.QilletniBreadcrumbsProvider"/>
        <liveTemplateContext contextId="Qilletni" implementation="dev.qilletni.intellij.editor.QilletniTemplateContextType"/>
        <defaultLiveTemplates file="/liveTemplates/Qilletni.xml"/>
        <internalFileTemplate name="Qilletni File"/>
        <internalFileTemplate name="Qilletni Entity"/>
        <lang.quoteHandler language="Qilletni" implementationClass="dev.qilletni.intellij.QilletniQuoteHandler"/>
        <enterHandlerDelegate implementation="dev.qilletni.intellij.QilletniEnterHandler"/>
        <typedHandler implementation="dev.qilletni.intellij.completion.QilletniTypedHandler"/>
        <intentionAction>
            <language>Qilletni</language>
            <category>Qilletni</category>
            <className>dev.qilletni.intellij.intentions.QilletniSelectSpotifyIntention</className>
            <descriptionDirectoryName>dev.qilletni.intellij.intentions.QilletniSelectSpotifyIntention</descriptionDirectoryName>
        </intentionAction>
        <codeInsight.lineMarkerProvider language="Qilletni" implementationClass="dev.qilletni.intellij.gutter.QilletniMusicLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="Qilletni" implementationClass="dev.qilletni.intellij.gutter.QilletniNativeBindingLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.qilletni.intellij.gutter.QilletniJavaToQilletniLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.qilletni.intellij.gutter.QilletniJavaClassToYamlLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="yaml" implementationClass="dev.qilletni.intellij.gutter.QilletniYamlNativeClassLineMarkerProvider"/>
        <gotoDeclarationHandler implementation="dev.qilletni.intellij.yaml.QilletniJavaClassToYamlGotoDeclarationHandler"/>
        <additionalLibraryRootsProvider implementation="dev.qilletni.intellij.library.QilletniAdditionalLibraryRootsProvider"/>
        <stubElementTypeHolder class="dev.qilletni.intellij.psi.QilletniTypes" externalIdPrefix="qilletni."/>
        <stubIndex implementation="dev.qilletni.intellij.index.QilletniEntityIndex"/>
        <stubIndex implementation="dev.qilletni.intellij.index.QilletniFunctionIndex"/>
        <stubIndex implementation="dev.qilletni.intellij.index.QilletniExtMethodIndex"/>
        <lang.importOptimizer language="Qilletni" implementationClass="dev.qilletni.intellij.refactoring.QilletniImportOptimizer"/>

        <applicationService serviceImplementation="dev.qilletni.intellij.toolchain.QilletniToolchainSettings"/>
        
        <projectConfigurable instance="dev.qilletni.intellij.settings.QilletniConfigurable"
                              id="dev.qilletni.intellij.settings"
                              key="settings.qilletni.displayName"
                              parentId="language"
                              nonDefaultProject="false"/>
        <projectConfigurable instance="dev.qilletni.intellij.settings.QilletniSpotifyConfigurable"
                             id="dev.qilletni.intellij.settings.services"
                             key="settings.services.displayName"
                             parentId="dev.qilletni.intellij.settings"
                             nonDefaultProject="false"/>
        <projectConfigurable instance="dev.qilletni.intellij.settings.QilletniRegistryConfigurable"
                             id="dev.qilletni.intellij.settings.registry"
                             key="settings.registry.displayName"
                             parentId="dev.qilletni.intellij.settings"
                             nonDefaultProject="false"/>

        <toolWindow id="Qilletni" factoryClass="dev.qilletni.intellij.toolwindow.QilletniToolWindowFactory"
                    anchor="right" icon="/icons/icon.svg" canCloseContents="false"/>
        <editorNotificationProvider implementation="dev.qilletni.intellij.toolwindow.QilletniSetupNotificationProvider"/>

        <newProjectWizard.languageGenerator implementation="dev.qilletni.intellij.project.QilletniLanguageNewProjectWizard"/>

        <configurationType implementation="dev.qilletni.intellij.runconfig.QilletniRunConfigurationType"/>
        <configurationType implementation="dev.qilletni.intellij.runconfig.QilletniBuildRunConfigurationType"/>
        <runConfigurationProducer implementation="dev.qilletni.intellij.runconfig.QilletniRunConfigurationProducer"/>
        <runConfigurationProducer implementation="dev.qilletni.intellij.runconfig.QilletniBuildRunConfigurationProducer"/>
        <runLineMarkerContributor language="Qilletni" implementationClass="dev.qilletni.intellij.runconfig.QilletniRunLineMarkerContributor"/>

        <postStartupActivity implementation="dev.qilletni.intellij.project.QilletniRootsListenerStartupActivity"/>
        <postStartupActivity implementation="dev.qilletni.intellij.project.QilletniLibrariesStartupActivity"/>
        <notificationGroup id="Qilletni" displayType="BALLOON" key="notification.group.qilletni"/>

        <localInspection language="Qilletni"
                          groupPath="Qilletni"
                          shortName="ExtensionReceiverParam"
                          displayName="Extension function must declare receiver parameter"
                          enabledByDefault="true"
                          implementationClass="dev.qilletni.intellij.inspections.QilletniExtensionReceiverParamInspection"/>

        <codeInsight.declarativeInlayProvider
                group="PARAMETERS_GROUP"
                implementationClass="dev.qilletni.intellij.hints.QilletniExtensionReceiverDeclarativeHintsProvider"
                isEnabledByDefault="true"
                language="Qilletni"
                nameKey="qilletni.inlay.receiverType.name"
                providerId="qilletni.receiverType"/>
    </extensions>

    <actions resource-bundle="messages.QilletniBundle">
        <action id="dev.qilletni.intellij.actions.QilletniSelectSpotifyAction" class="dev.qilletni.intellij.actions.QilletniSelectSpotifyAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt M"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt M" replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt M" replace-all="true"/>
        </action>

        <action id="Qilletni.NewFile" class="dev.qilletni.intellij.editor.QilletniCreateFileAction" icon="/icons/icon.svg">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFromTemplate"/>
        </action>

        <action id="Qilletni.Sync" class="dev.qilletni.intellij.actions.QilletniPackageActions$Sync" icon="AllIcons.Actions.Download"/>
        <action id="Qilletni.UpdateLockfile" class="dev.qilletni.intellij.actions.QilletniPackageActions$UpdateLockfile" icon="AllIcons.Actions.ForceRefresh"/>
        <action id="Qilletni.Build" class="dev.qilletni.intellij.actions.QilletniPackageActions$Build" icon="AllIcons.Actions.Compile"/>
        <action id="Qilletni.PublishLocal" class="dev.qilletni.intellij.actions.QilletniPackageActions$PublishLocal" icon="AllIcons.Nodes.PpLib"/>
        <action id="Qilletni.Publish" class="dev.qilletni.intellij.actions.QilletniPackageActions$Publish" icon="AllIcons.Actions.Upload"/>
        <action id="Qilletni.GenerateDocs" class="dev.qilletni.intellij.actions.QilletniPackageActions$GenerateDocs" icon="AllIcons.Toolwindows.Documentation"/>
        <action id="Qilletni.SpotifySignIn" class="dev.qilletni.intellij.actions.QilletniAccountActions$SpotifySignIn"/>
        <action id="Qilletni.RegistryLogin" class="dev.qilletni.intellij.actions.QilletniAccountActions$RegistryLogin"/>
        <action id="Qilletni.OpenSettings" class="dev.qilletni.intellij.actions.QilletniAccountActions$OpenSettings" icon="AllIcons.General.Settings"/>
        <action id="Qilletni.ResetLibraryCache" class="dev.qilletni.intellij.actions.QilletniResetLibraryCacheAction"/>
        <action id="Qilletni.Refresh" class="dev.qilletni.intellij.toolwindow.QilletniRefreshAction" icon="AllIcons.Actions.Refresh"/>

        <group id="Qilletni.ToolsMenu" popup="true">
            <reference ref="Qilletni.Sync"/>
            <reference ref="Qilletni.UpdateLockfile"/>
            <separator/>
            <reference ref="Qilletni.Build"/>
            <reference ref="Qilletni.PublishLocal"/>
            <reference ref="Qilletni.Publish"/>
            <reference ref="Qilletni.GenerateDocs"/>
            <separator/>
            <reference ref="Qilletni.SpotifySignIn"/>
            <reference ref="Qilletni.RegistryLogin"/>
            <separator/>
            <reference ref="Qilletni.ResetLibraryCache"/>
            <reference ref="Qilletni.OpenSettings"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>

        <group id="Qilletni.ToolWindow.Toolbar">
            <reference ref="Qilletni.Refresh"/>
            <reference ref="Qilletni.Sync"/>
            <separator/>
            <reference ref="Qilletni.Build"/>
            <reference ref="Qilletni.PublishLocal"/>
            <reference ref="Qilletni.Publish"/>
            <separator/>
            <group id="Qilletni.ToolWindow.More" popup="true" icon="AllIcons.Actions.More">
                <reference ref="Qilletni.UpdateLockfile"/>
                <reference ref="Qilletni.GenerateDocs"/>
                <separator/>
                <reference ref="Qilletni.SpotifySignIn"/>
                <reference ref="Qilletni.RegistryLogin"/>
                <separator/>
                <reference ref="Qilletni.ResetLibraryCache"/>
                <reference ref="Qilletni.OpenSettings"/>
            </group>
        </group>
    </actions>
</idea-plugin>